{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      { "include": "**/*.hbs", "outDir": "dist/src/" },
      { "include": "**/*.svg", "outDir": "dist/src/" },
      { "include": "**/*.json", "outDir": "dist/src/" },
      { "include": "../client/**/*", "outDir": "dist/client/" }
    ],
    "watchAssets": true,
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger/plugin",
        "options": {
          "classValidatorShim": true
        }
      }
    ]
  }
}

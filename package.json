    "jsonwebtoken": "^8.5.1",
    "jwk-to-pem": "^2.0.5",
    "moment": "^2.29.4",
    "mysql": "^2.18.1",
    "nodemailer": "^6.8.0",
    "passport": "^0.6.0",
    "passport-local": "^1.0.0",
    "pg": "^8.8.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rut.js": "^2.1.0",
    "rxjs": "^7.2.0",
